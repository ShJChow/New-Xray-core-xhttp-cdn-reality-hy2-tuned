user root;
worker_processes auto;
# 与下面的 worker_connections 成对：只提高 worker_connections 而不抬句柄上限，
# nginx 会报 "worker_connections exceed open file resource limit"，实际上限
# 仍是 systemd unit 的默认值。安装期不写 systemd drop-in（那是 xh tuning on
# 的事），所以这一行必须在配置里自己声明。
# 取 worker_connections 的 2 倍：本项目所有连接都是代理（grpc_pass / proxy_pass），
# 每条连接同时占用「客户端 + 上游」两个描述符，1:1 会在半数连接处触顶。
worker_rlimit_nofile 131072;

error_log /usr/local/nginx/logs/error.log notice;
pid /run/nginx.pid;

events {
    # XHTTP 是持久长连接，每条客户端连接在 worker 里长期占位；1024 是 nginx 默认
    # 值，并发稍高就触顶，表现为客户端 502。这是可指名的故障现象，属正确性修复
    # 而非吞吐旋钮。
    # 代价：连接槽按此值预分配，约 15~20 MB/worker，worker_processes auto 下
    # 乘以核心数。小内存 VPS（< 1 GB）若觉得占用偏高，可自行调小到 8192。
    worker_connections 65535;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    set_real_ip_from      127.0.0.1;
    map \$http_cf_connecting_ip \$real_client_ip {
        default \$http_cf_connecting_ip;
        ""      \$remote_addr;
    }
    real_ip_header        X-Real-IP;

    sendfile              on;
    server_tokens         off;
    tcp_nodelay           on;
    tcp_nopush            on;
    client_max_body_size  0;
    client_body_buffer_size 512k;
    client_header_buffer_size 32k;
    large_client_header_buffers 4 32k;
    keepalive_timeout     300s 300s;
    keepalive_requests    100000;
    http2_max_concurrent_streams 1024;
    http2_body_preread_size 128k;
    http2_recv_buffer_size 512k;
    gzip                  off;

    add_header X-Content-Type-Options nosniff;

    ssl_session_cache          shared:SSL:16m;
    ssl_session_timeout        1h;
    ssl_session_tickets        off;
    ssl_protocols              TLSv1.3 TLSv1.2;
    ssl_ciphers                TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers  on;
    ssl_stapling               on;
    ssl_stapling_verify        on;
    resolver                   1.1.1.1 8.8.8.8 valid=60s ${NGINX_RESOLVER_IPV6};
    resolver_timeout           2s;

    map \$real_client_ip \$proxy_forwarded_elem {
        ~^[0-9.]+\$        "for=\$real_client_ip";
        ~^[0-9A-Fa-f:.]+\$ "for=\"[\$real_client_ip]\"";
        default           "for=unknown";
    }
    map \$http_forwarded \$proxy_add_forwarded {
        default "\$proxy_forwarded_elem";
    }
    # XHTTP 回源上游：不走 upstream 块时，nginx 为每个 POST/GET 流新建一条到
    # 8001 的 TCP+HTTP/2 连接。packet-up 模式下上行是大量小 POST，这笔握手开销
    # 直接落在每个包上。keepalive 让回源连接复用。
    upstream xray_xhttp {
        server 127.0.0.1:8001;
        keepalive          128;
        keepalive_requests 1000000;
        keepalive_timeout  3600s;
    }

    server {
        listen       8003 ssl;
        http2        on;
        server_name  ${REALITY_DOMAIN};

        ssl_certificate /etc/ssl/private/fullchain.cer;
        ssl_certificate_key /etc/ssl/private/private.key;

        location ^~ /sub/ {
            root /usr/local/nginx/html;
            try_files \$uri =404;
            autoindex off;
            types {
                text/plain txt;
                application/yaml yaml yml;
            }
            default_type text/plain;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        }

        location / {
$(nginx_fallback_config "$REALITY_DOMAIN" "$REALITY_FALLBACK_ORIGIN" "$REALITY_FALLBACK_HOST")
        }
    }

    server {
        listen       8003 ssl;
        http2        on;
        server_name  ${CDN_DOMAIN};

        ssl_certificate /etc/ssl/private/fullchain.cer;
        ssl_certificate_key /etc/ssl/private/private.key;

        location / {
$(nginx_fallback_config "$CDN_DOMAIN" "$CDN_FALLBACK_ORIGIN" "$CDN_FALLBACK_HOST")
        }

        location ${XHTTP_PATH} {
            grpc_pass grpc://xray_xhttp;
            # 下行吞吐：grpc_buffer_size 默认 4k，Xray 的下行数据要被切成 4k 一片
            # 经 HTTP/2 转发，系统调用数与 h2 帧开销成倍上升，是 CDN 节点慢的主因。
            grpc_buffer_size 512k;
            # XHTTP 是长连接：Nginx 默认 60s 读写超时会直接切断上下行，必须放大
            grpc_socket_keepalive on;
            grpc_read_timeout     1h;
            grpc_send_timeout     1h;
            grpc_connect_timeout  15s;
            grpc_set_header Host                  \$host;
            grpc_set_header X-Real-IP             \$real_client_ip;
            grpc_set_header Forwarded             \$proxy_add_forwarded;
            # 只传一个值：\$proxy_add_x_forwarded_for 会把本跳的 \$remote_addr
            # （回落进来时恒为 127.0.0.1）追加到链尾，Xray 判定整条链不可信而丢弃，
            # 每个请求打一条 [Error] ignored potentially forged "X-Forwarded-For"。
            grpc_set_header X-Forwarded-For       \$real_client_ip;
            grpc_set_header X-Forwarded-Proto     \$scheme;
        }
    }

    server {
        listen  80 default_server;
        server_name _;
        return 301 https://\$host\$request_uri;
    }
}
