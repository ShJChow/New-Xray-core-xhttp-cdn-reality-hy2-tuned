{
    "log": {
        "loglevel": "info"
    },
    "dns": {
        "servers": [
            "8.8.8.8",
            "1.1.1.1",
            "localhost"
        ],
        "queryStrategy": "UseIPv4"
    },
    ${XRAY_POLICY_JSON}
    "routing": {
        "domainStrategy": "AsIs",
        "rules": [
            {
                "type": "field",
                "ip": [
                    "geoip:private"
                ],
                "outboundTag": "block"
            },
            {
                "type": "field",
                "protocol": [
                    "bittorrent"
                ],
                "outboundTag": "block"
            },
            {
                "type": "field",
                "domain": [
                    "geosite:category-pt"
                ],
                "outboundTag": "block"
            }
        ]
    },
    "inbounds": [
        {
            "listen": "0.0.0.0",
            "port": 443,
            "protocol": "vless",
            "settings": {
                "clients": [
                    {
                        "id": "${UUID1}",
                        "level": 0,
                        "flow": "xtls-rprx-vision"
                    }
                ],
                "decryption": "none",
                "fallbacks": [
                    {
                        "dest": "127.0.0.1:8001",
                        "xver": 0
                    }
                ]
            },
            "streamSettings": {
                "network": "raw",
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "target": "127.0.0.1:8003",
                    "xver": 0,
                    "serverNames": [
                        "${REALITY_DOMAIN}",
                        "${CDN_DOMAIN}"
                    ],
                    "privateKey": "${PRIVATE_KEY}",
                    "shortIds": [
                        "${SHORT_ID}"
                    ]
                    // 不设置 minClientVer：按安全性优先的取舍，遵循 Xray 26.x 的新默认值
                    // （即 Xray-core v26.3.27），把 Reality 的探测面收到最小。代价是
                    // mihomo / sing-box / Clash 系等非最新 Xray 内核客户端握手会报
                    // REALITY authentication failed（启动日志里 "other clients may be
                    // refused to connect" 说的就是这个）。如需兼容这些客户端，加回
                    // "minClientVer": "1.8.0"，但要接受 `xray run -test` 提示的代价：
                    // 会增加服务器 IP 被 GFW 封锁的概率。
                }${REALITY_SOCKOPT_JSON}
            },
            "sniffing": {
                "enabled": true,
                "destOverride": ["http", "tls", "quic"],
                "metadataOnly": false,
                "routeOnly": true
            }
        },
        {
            "listen": "127.0.0.1",
            "port": 8001,
            "protocol": "vless",
            "settings": {
                "clients": [
                    {
                        "id": "${UUID2}",
                        "level": 0
                    }
                ],
                "decryption": "${VLESSENC_DECRYPTION}"
            },
            "streamSettings": {
                "network": "xhttp",
                // 本入站只接受来自 127.0.0.1 的 Nginx 反代，nginx.conf 已通过
                // grpc_set_header 传入 X-Real-IP / X-Forwarded-For（经 CDN 时由
                // $http_cf_connecting_ip 取得真实客户端 IP）。不声明本项时 Xray
                // 不信任该头，会退回使用 socket 对端地址——即 127.0.0.1，导致：
                //   1) 所有经 CDN 的流量在日志里都记成 127.0.0.1，真实客户端 IP 丢失，
                //      只有直连 Reality 的流量能看到真实 IP；
                //   2) 每个请求打一条 Warning，实测占 xray 日志总量的约 50%。
                // 注意语义：本项填的是「头名」而非 IP —— Xray 只有在请求里存在
                // 列表中任一头名时才采信 X-Forwarded-For，并取其最左一段作为客户端 IP
                // （见 common/protocol/http.ApplyTrustedXForwardedFor）。填 IP 永远不匹配，
                // 结果是每个请求打一条 [Error] ignored potentially forged。
                // 取 X-Real-IP：nginx 用 grpc_set_header 无条件覆盖该头，客户端伪造不进来；
                // 本入站又仅监听回环，只可能由 nginx 回源到达。
                "sockopt": {
                    "trustedXForwardedFor": ["X-Real-IP"],
                    "tcpFastOpen": true,
                    "tcpcongestion": "bbr",
                    "tcpKeepAliveIdle": 30,
                    "tcpKeepAliveInterval": 5,
                    "tcpUserTimeout": 300000
                },
                "xhttpSettings": {
                    "host": "",
                    "path": "${XHTTP_PATH}",
                    "mode": "auto"${XRAY_XHTTP_PADDING_JSON}
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": ["http", "tls", "quic"],
                "metadataOnly": false,
                "routeOnly": true
            }
        }${XRAY_H3_DIRECT_INBOUND}${XRAY_H2_DIRECT_INBOUND}${XRAY_HY2_INBOUND}
    ],
    "outbounds": [
        {
            "protocol": "freedom",
            "tag": "direct",
            "settings": {
                "domainStrategy": "UseIPv4"
            },
            "streamSettings": {
                "sockopt": {
                    "tcpFastOpen": true,
                    "tcpcongestion": "bbr",
                    "tcpKeepAliveIdle": 30,
                    "tcpKeepAliveInterval": 5,
                    "tcpUserTimeout": 300000
                }
            }
        },
        {
            "protocol": "blackhole",
            "tag": "block"
        }
    ]
}
