# 节点顺序 = HTTP/3 优先。mihomo-full.yaml.tmpl 的 proxy-groups 用 include-all: true，
# 不逐条列节点名，因此策略组里的排列顺序完全由这里的 proxies 数组顺序决定。
# 第 1 条经 CDN 走 TCP(h2)，第 2、3 条是 QUIC/h3 直连，后两条是 TCP 直连兜底。
proxies:
  # ---------- 经 CDN / QUIC 直连 ----------
  # 1. 经 CDN：走 TCP（h2）。alpn 恰好只有 h3 时 mihomo 才走 HTTP/3
  #    （transport/xhttp/client.go:159），本节点**刻意不这么做**。
  #    改动理由（v4.2.2）：h3 把这条链路压在 UDP 443 上，而中国移动等运营商
  #    对出境 UDP 443 普遍限速，且 alpn 只有 h3 时 mihomo 不会回落 TCP，
  #    表现为该节点单独很慢而其余节点正常。
  #    实测（服务器本机发起，CF 边缘就近，回源侧无差异）：
  #      h3 65-77 MB/s，h2 73-85 MB/s，h2+http/1.1 73-85 MB/s，上行均 ~26 MB/s。
  #    h3 的收益仅存在于 UDP 通畅的网络，代价是 UDP 被限速时无解。
  #    故改为 h2 + http/1.1（Chrome 真实 ALPN 组合，指纹也更自然）。
  #    仍需要 QUIC 时用 Vless-xhttp-h3-direct（直连 UDP ${H3_PORT}，不经 CDN）。
  - name: Vless-xhttp-tls-UDP-cdn-${HOSTNAME_TAG}
    type: vless
    server: ${CDN_DOMAIN}
    port: 443
    uuid: ${UUID2}
    udp: true
    flow: ""
    tls: true
    network: xhttp
    alpn:
      - h2
      - http/1.1
    servername: ${CDN_DOMAIN}
    client-fingerprint: chrome
    encryption: ${VLESSENC_ENCRYPTION}${MIHOMO_ECH_PROXY_BLOCK}
    xhttp-opts:
      host: ${CDN_DOMAIN}
      path: ${XHTTP_PATH}
      mode: auto${MIHOMO_XPADDING_XHTTP_BLOCK}${MIHOMO_SC_MIN_POSTS_BLOCK}
      reuse-settings:
        max-concurrency: "16-32"
        c-max-reuse-times: "0"
        h-max-reusable-secs: "1800-3000"${MIHOMO_REUSE_KEEPALIVE_XHTTP}

  # 2. 直连 VPS 的 h3（UDP ${H3_PORT}）：不经 CDN，Xray 自己监听 UDP。
  #    sni 用 Reality 域名——证书是 Reality+CDN 双域名 SAN，直连侧用前者。
  - name: Vless-xhttp-h3-direct-${HOSTNAME_TAG}
    type: vless
    server: ${VPS_IP}
    port: ${H3_PORT}
    uuid: ${UUID2}
    udp: true
    flow: ""
    tls: true
    network: xhttp
    alpn:
      - h3
    servername: ${REALITY_DOMAIN}
    client-fingerprint: chrome
    encryption: ${VLESSENC_ENCRYPTION}
    xhttp-opts:
      path: ${XHTTP_PATH}
      mode: auto${MIHOMO_XPADDING_XHTTP_BLOCK}${MIHOMO_SC_MIN_POSTS_BLOCK}
      reuse-settings:
        max-concurrency: "16-32"
        c-max-reuse-times: "0"
        h-max-reusable-secs: "1800-3000"${MIHOMO_REUSE_KEEPALIVE_XHTTP}

  # 3. Hysteria2 + Salamander 混淆（UDP ${HY2_PORT}）：由 Xray 原生 hysteria
  #    inbound 提供，不再需要独立的 hysteria 二进制。
  #    up/down 留空 = 客户端用 BBR；填具体值则切到 Brutal 模式。
  - name: Hysteria2-obfs-${HOSTNAME_TAG}
    type: hysteria2
    server: ${VPS_IP}
    port: ${HY2_PORT}
    password: ${HY2_PASSWORD}
    obfs: salamander
    obfs-password: ${OBFS_PASSWORD}
    sni: ${REALITY_DOMAIN}
    skip-cert-verify: false
    alpn:
      - h3

  # ---------- TCP 兜底（UDP/QUIC 被封时使用）----------
  - name: Vless-reality-vision-${HOSTNAME_TAG}
    type: vless
    server: ${VPS_IP}
    port: 443
    uuid: ${UUID1}
    udp: true
    tls: true
    flow: xtls-rprx-vision
    encryption: "none"
    network: tcp
    alpn:
      - h2
    servername: ${REALITY_DOMAIN}
    client-fingerprint: chrome
    reality-opts:
      public-key: ${PUBLIC_KEY}
      short-id: ${SHORT_ID}

  - name: Vless-xhttp-reality-${HOSTNAME_TAG}
    type: vless
    server: ${VPS_IP}
    port: 443
    uuid: ${UUID2}
    udp: true
    flow: ""
    tls: true
    encryption: ${VLESSENC_ENCRYPTION}
    network: xhttp
    alpn:
      - h2
    servername: ${REALITY_DOMAIN}
    client-fingerprint: chrome
    reality-opts:
      public-key: ${PUBLIC_KEY}
      short-id: ${SHORT_ID}
    xhttp-opts:
      path: ${XHTTP_PATH}
      mode: auto${MIHOMO_XPADDING_XHTTP_BLOCK}
      reuse-settings:
        max-concurrency: "16-32"
        c-max-reuse-times: "0"
        h-max-reusable-secs: "1800-3000"${MIHOMO_REUSE_KEEPALIVE_XHTTP}
