# 节点顺序 = HTTP/3 优先。mihomo-full.yaml.tmpl 的 proxy-groups 用 include-all: true，
# 不逐条列节点名，因此策略组里的排列顺序完全由这里的 proxies 数组顺序决定。
# 第 1 条经 CDN 走 TCP(h2)，第 2 条 QUIC/h3 直连，第 3 条是它的 TCP 孪生体（v4.7.0），
# 第 4 条 Hysteria2，后两条是 Reality TCP 直连兜底。
proxies:
  # ---------- 经 CDN / QUIC 直连 ----------
  # 1. 经 CDN 的 QUIC 链路（v4.7.4 新增）：
  #    mihomo 仅在 alpn 恰好等于 h3 时才走 HTTP/3（transport/xhttp/client.go:159）。
  #    服务端零改动：ALPN 是客户端与 Cloudflare 边缘之间的协商，回源侧恒为 h2/TCP，
  #    因此这条节点不占用任何额外端口，也不需要安全组放行。
  - name: Vless-xhttp-h3-cdn-${HOSTNAME_TAG}
    type: vless
    server: ${CDN_DOMAIN}
    port: 443
    uuid: ${UUID2}
    udp: true
    flow: ""
    tls: true
    network: xhttp
    alpn:
      - h3
    servername: ${CDN_DOMAIN}
    client-fingerprint: chrome
    encryption: ${VLESSENC_ENCRYPTION}${MIHOMO_ECH_PROXY_BLOCK}
    xhttp-opts:
      host: ${CDN_DOMAIN}
      path: ${XHTTP_PATH}
      mode: auto${MIHOMO_XPADDING_XHTTP_BLOCK}${MIHOMO_SC_MIN_POSTS_BLOCK}
      reuse-settings:
        max-concurrency: "16-32"
        c-max-reuse-times: "0"
        h-max-request-times: "600-900"
        h-max-reusable-secs: "1800-3000"${MIHOMO_REUSE_KEEPALIVE_XHTTP}

  #<<FEATURE_H3_DIRECT
  # 2. 直连 VPS 的 h3（UDP ${H3_PORT}）：不经 CDN，Xray 自己监听 UDP。
  #    sni 用 Reality 域名——证书是 Reality+CDN 双域名 SAN，直连侧用前者。
  - name: Vless-xhttp-h3-direct-${HOSTNAME_TAG}
    type: vless
    server: ${VPS_IP}
    port: ${H3_PORT}
    uuid: ${UUID2}
    udp: true
    flow: ""
    tls: true
    network: xhttp
    alpn:
      - h3
    servername: ${REALITY_DOMAIN}
    client-fingerprint: chrome
    encryption: ${VLESSENC_ENCRYPTION}
    xhttp-opts:
      path: ${XHTTP_PATH}
      mode: stream-up${MIHOMO_XPADDING_XHTTP_BLOCK}${MIHOMO_SC_MIN_POSTS_BLOCK}
      reuse-settings:
        max-concurrency: "16-32"
        c-max-reuse-times: "0"
        h-max-request-times: "600-900"
        h-max-reusable-secs: "1800-3000"${MIHOMO_REUSE_KEEPALIVE_XHTTP}
  #>>FEATURE_H3_DIRECT

  #<<FEATURE_H2_DIRECT
  # 2b. 直连 VPS 的 h2（TCP ${H2_PORT}）：与上面的 h3 节点同 UUID、同 path、
  #     同 decryption，只把传输层换成 TCP。存在理由是 h3 节点整条压在 UDP 上，
  #     运营商封 UDP 或 QUIC 丢包严重时它完全不可用，而 mihomo 在 alpn 只有 h3
  #     时不会自动回落 TCP（transport/xhttp/client.go:159）——表现为该节点
  #     单独连不上。两者由下面的「直连择优」url-test 组自动接管。
  - name: Vless-xhttp-h2-tcp-direct-${HOSTNAME_TAG}
    type: vless
    server: ${VPS_IP}
    port: ${H2_PORT}
    uuid: ${UUID2}
    udp: true
    flow: ""
    tls: true
    tfo: true
    network: xhttp
    alpn:
      - h2
      - http/1.1
    servername: ${REALITY_DOMAIN}
    client-fingerprint: chrome
    encryption: ${VLESSENC_ENCRYPTION}
    xhttp-opts:
      path: ${XHTTP_PATH}
      mode: stream-up${MIHOMO_XPADDING_XHTTP_BLOCK}${MIHOMO_SC_MIN_POSTS_BLOCK}
      reuse-settings:
        max-concurrency: "16-32"
        c-max-reuse-times: "0"
        h-max-request-times: "600-900"
        h-max-reusable-secs: "1800-3000"${MIHOMO_REUSE_KEEPALIVE_XHTTP}
  #>>FEATURE_H2_DIRECT

  #<<FEATURE_HY2
  # 3. Hysteria2 + Salamander 混淆（UDP ${HY2_PORT}）：由 Xray 原生 hysteria
  #    inbound 提供，不再需要独立的 hysteria 二进制。
  #    up/down 留空 = 客户端用 BBR；填具体值则切到 Brutal 模式。
  - name: Hysteria2-obfs-${HOSTNAME_TAG}
    type: hysteria2
    server: ${VPS_IP}
    port: ${HY2_PORT}
    password: ${HY2_PASSWORD}
    obfs: salamander
    obfs-password: ${OBFS_PASSWORD}
    sni: ${REALITY_DOMAIN}
    skip-cert-verify: false
    up: "100 Mbps"
    down: "1000 Mbps"
    alpn:
      - h3
  #>>FEATURE_HY2

  # ---------- TCP 兜底（UDP/QUIC 被封时使用）----------
  - name: Vless-reality-vision-${HOSTNAME_TAG}
    type: vless
    server: ${VPS_IP}
    port: 443
    uuid: ${UUID1}
    udp: true
    tls: true
    flow: xtls-rprx-vision
    encryption: "none"
    network: tcp
    servername: ${REALITY_DOMAIN}
    client-fingerprint: chrome
    reality-opts:
      public-key: ${PUBLIC_KEY}
      short-id: ${SHORT_ID}

  - name: Vless-xhttp-reality-${HOSTNAME_TAG}
    type: vless
    server: ${VPS_IP}
    port: 443
    uuid: ${UUID2}
    udp: true
    flow: ""
    tls: true
    encryption: ${VLESSENC_ENCRYPTION}
    network: xhttp
    alpn:
      - h2
    servername: ${REALITY_DOMAIN}
    client-fingerprint: chrome
    reality-opts:
      public-key: ${PUBLIC_KEY}
      short-id: ${SHORT_ID}
    xhttp-opts:
      path: ${XHTTP_PATH}
      mode: stream-up${MIHOMO_XPADDING_XHTTP_BLOCK}
      reuse-settings:
        max-concurrency: "16-32"
        c-max-reuse-times: "0"
        h-max-request-times: "600-900"
        h-max-reusable-secs: "1800-3000"${MIHOMO_REUSE_KEEPALIVE_XHTTP}

  - name: Vless-xhttp-reality-up-cdn-down-${HOSTNAME_TAG}
    type: vless
    server: ${VPS_IP}
    port: 443
    uuid: ${UUID2}
    udp: true
    flow: ""
    tls: true
    encryption: ${VLESSENC_ENCRYPTION}
    network: xhttp
    alpn:
      - h2
    servername: ${REALITY_DOMAIN}
    client-fingerprint: chrome
    reality-opts:
      public-key: ${PUBLIC_KEY}
      short-id: ${SHORT_ID}
    xhttp-opts:
      path: ${XHTTP_PATH}
      mode: stream-up${MIHOMO_XPADDING_XHTTP_BLOCK}
      reuse-settings:
        max-concurrency: "16-32"
        c-max-reuse-times: "0"
        h-max-request-times: "600-900"
        h-max-reusable-secs: "1800-3000"${MIHOMO_REUSE_KEEPALIVE_XHTTP}
      download-settings:
        server: ${CDN_DOMAIN}
        port: 443
        network: xhttp
        tls: true
        alpn:
          - h2
          - http/1.1
        servername: ${CDN_DOMAIN}
        client-fingerprint: chrome${MIHOMO_ECH_DOWNLOAD_BLOCK}
        xhttp-opts:
          host: ${CDN_DOMAIN}
          path: ${XHTTP_PATH}
          mode: auto${MIHOMO_XPADDING_DOWNLOAD_BLOCK}
          reuse-settings:
            max-concurrency: "16-32"
            c-max-reuse-times: "0"
            h-max-request-times: "600-900"
            h-max-reusable-secs: "1800-3000"${MIHOMO_REUSE_KEEPALIVE_DOWNLOAD}

